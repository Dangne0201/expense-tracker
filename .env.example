# Copy this file to .env and fill in real secrets. DO NOT commit the real .env to the repository.
# SA_PASSWORD must meet SQL Server complexity requirements (at least 8 characters, uppercase, lowercase, digits, symbols).
SA_PASSWORD=YourStrong!Passw0rd
MSSQL_PID=Developer
ACCEPT_EULA=Y
# Optional: name for your database (you can create it via migration or sql script)
DATABASE_NAME=ExpenseDb
