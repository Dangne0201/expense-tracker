{
  "categories": [
    {
      "name": "docs",
      "path": "docs",
      "patterns": ["*.md"]
    },
    {
      "name": "scripts_setup",
      "path": "scripts\\setup",
      "patterns": ["setup-*.ps1","start-*.ps1","*.bat"]
    },
    {
      "name": "scripts_tests",
      "path": "scripts\\tests",
      "patterns": ["run-*.ps1","smoke-*.ps1"]
    },
    {
      "name": "src",
      "path": "src",
      "patterns": ["**\\*.cs","**\\*.csproj"]
    },
    {
      "name": "data",
      "path": "data",
      "patterns": ["*.sql","*.mdf"]
    },
    {
      "name": "artifacts",
      "path": "artifacts",
      "patterns": ["*.zip","*.nupkg"]
    }
  ],
  "defaultCategory": {
    "name": "misc",
    "path": "misc",
    "patterns": []
  }
}
