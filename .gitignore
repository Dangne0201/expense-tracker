# .gitignore cho dự án .NET
bin/
obj/
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# NuGet
*.nupkg

# EF Migrations snapshot or generated files (tùy theo project)
**/Migrations/

# Docker env file (chứa secrets)
.env

# Visual Studio Code settings
.local.settings.json

# Logs
*.log

# OS files
Thumbs.db
Desktop.ini

# Local DB and backups
# Ignore SQL Server database files and temp files in data/ (DB binaries are large and machine-specific)
data/*.mdf
data/*.ndf
data/*.ldf
# Keep init.sql and other scripts

# other
.properties
